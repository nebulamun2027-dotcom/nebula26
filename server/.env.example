# NEBULA MUN 2026 — NEBULA AI Backend
# Secure backend API for the NEBULA AI conference assistant.
# All API credentials live here — never in frontend JavaScript.

# AI provider configuration
# Supported providers: openai, anthropic, generic (OpenAI-compatible, incl. NVIDIA NIM)
AI_PROVIDER=generic

# API key for your chosen AI provider (keep secret, never commit this file)
# NVIDIA NIM keys start with "nvapi-"
AI_API_KEY=your_api_key_here

# Model to use for completions (REQUIRED — no default in source code)
# Example NVIDIA NIM model: nvidia/llama-3.1-nemotron-70b-instruct
AI_MODEL=

# Base URL for the AI API (for OpenAI-compatible endpoints)
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# OpenAI: https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# Server port
PORT=3001

# CORS origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:8765
